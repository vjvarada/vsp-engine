# VSP Engine — Environment Variables
# Copy this to .env and fill in real values
# NEVER commit .env to git

# Application
APP_ENV=development
SECRET_KEY=change-this-to-a-random-256-bit-key
ALLOWED_ORIGINS=http://localhost:5173

# Database
DATABASE_URL=postgresql+asyncpg://vsp:vsp@localhost:5432/vsp

# Redis / Celery
REDIS_URL=redis://localhost:6379/0

# MinIO / S3
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=vspengine
MINIO_SECRET_KEY=change-this-minio-secret
MINIO_BUCKET=vsp-studies
MINIO_USE_SSL=false
STUDY_TTL_DAYS=30

# GPU
GPU_DEVICE=cuda:0
GPU_DEVICE_MEDSAM2=cuda:0

# MedSAM2 service URL (internal Docker network)
MEDSAM2_BASE_URL=http://medsam2:8001

# TotalSegmentator license (required for appendicular_bones task)
# TOTALSEG_LICENSE_KEY=your-license-key-here

# Logging
LOG_LEVEL=INFO
